# Copy this template to a private `.env` file on the server.
# Do not commit real production secrets.

NODE_ENV=production
HOST=0.0.0.0
PORT=5000
DEBUG_LOGS=0
LOG_LEVEL=info

PUBLIC_APP_URL=https://domain-anda.com
CORS_ALLOWED_ORIGINS=https://domain-anda.com
TRUSTED_PROXIES=loopback
AUTH_COOKIE_SECURE=auto
HSTS_MAX_AGE_SECONDS=31536000
# Enable only after every production subdomain is HTTPS-only, then submit the
# domain to https://hstspreload.org.
HSTS_PRELOAD_ENABLED=0

SESSION_SECRET=ganti-dengan-random-secret-yang-panjang-dan-kuat
SESSION_SECRET_PREVIOUS=
# Required outside strict local development. Use a unique random value and do
# not reuse SESSION_SECRET.
TWO_FACTOR_ENCRYPTION_KEY=ganti-dengan-secret-2fa-yang-kuat-dan-berbeza

COLLECTION_PII_ENCRYPTION_KEY=ganti-dengan-secret-pii-yang-kuat-dan-berbeza

PG_HOST=127.0.0.1
PG_PORT=5432
PG_USER=sqr_app
# Store the real value in a restricted deployment secret file/manager. Do not
# paste it into shell commands where it can land in history or process listings.
PG_PASSWORD=ganti-dengan-password-db-yang-kuat
PG_DATABASE=sqr_db
PG_MAX_CONNECTIONS=10
PG_IDLE_TIMEOUT_MS=30000
PG_CONNECTION_TIMEOUT_MS=5000
PG_SEARCH_PATH=public

COLLECTION_NICKNAME_TEMP_PASSWORD=
COLLECTION_RECEIPT_QUARANTINE_ENABLED=1
COLLECTION_RECEIPT_QUARANTINE_DIR=var/collection-receipt-quarantine
COLLECTION_RECEIPT_EXTERNAL_SCAN_ENABLED=1
COLLECTION_RECEIPT_EXTERNAL_SCAN_COMMAND=clamdscan
COLLECTION_RECEIPT_EXTERNAL_SCAN_ARGS_JSON='["--fdpass","--no-summary","--infected","{file}"]'
COLLECTION_RECEIPT_EXTERNAL_SCAN_TIMEOUT_MS=60000
COLLECTION_RECEIPT_EXTERNAL_SCAN_FAIL_CLOSED=1
COLLECTION_RECEIPT_EXTERNAL_SCAN_CLEAN_EXIT_CODES=0
COLLECTION_RECEIPT_EXTERNAL_SCAN_REJECT_EXIT_CODES=1

MAIL_FROM=notifikasi@domain-anda.com
SMTP_SERVICE=
SMTP_HOST=smtp.provider-anda.com
SMTP_PORT=587
SMTP_USER=akaun-smtp
SMTP_PASSWORD=ganti-dengan-kredensial-smtp
SMTP_SECURE=false
SMTP_REQUIRE_TLS=true
MAIL_DEV_OUTBOX_ENABLED=0
MAIL_DEV_OUTBOX_DIR=var/dev-mail-outbox
MAIL_DEV_OUTBOX_MAX_FILES=100

OLLAMA_HOST=http://127.0.0.1:11434
# Required only when AI chat / semantic search is enabled. If you run without
# Ollama, leave the AI feature flags at conservative defaults and expect the app
# to fall back or fail closed on AI-specific requests.
OLLAMA_CHAT_MODEL=llama3:8b
OLLAMA_EMBED_MODEL=nomic-embed-text
OLLAMA_TIMEOUT_MS=6000
DEFAULT_AI_TIMEOUT_MS=6000
AI_DEBUG=0
AI_PRECOMPUTE_ON_START=0
AI_GATE_GLOBAL_LIMIT=4
AI_GATE_SUPERUSER_LIMIT=1
AI_GATE_ADMIN_LIMIT=1
AI_GATE_USER_LIMIT=2
AI_GATE_QUEUE_LIMIT=20
AI_GATE_QUEUE_WAIT_MS=12000
AI_LATENCY_DECAY_HALF_LIFE_MS=30000
AI_LATENCY_STALE_AFTER_MS=20000

SQR_LOW_MEMORY_MODE=1
SQR_MAX_SEARCH_CACHE_ENTRIES=60
SQR_MAX_AI_LAST_PERSON_ENTRIES=40
SQR_AI_LAST_PERSON_TTL_MS=1800000
# Required in production. Redis shares fixed-window rate limits, adaptive
# protection buckets, 2FA replay checks, and JWT logout revocation state.
SQR_RATE_LIMIT_STORE=redis
SQR_REDIS_RATE_LIMIT_URL=rediss://:ganti-dengan-password-redis@redis.internal:6380/0
SQR_RATE_LIMIT_USER_READS_PER_MINUTE=500
SQR_RATE_LIMIT_USER_WRITES_PER_MINUTE=100
SQR_RATE_LIMIT_USER_UPLOADS_PER_MINUTE=10
SQR_REDIS_HEALTH_CHECK_INTERVAL_MS=60000
# Keep memory for single-worker WebSocket fan-out. Set redis before raising
# SQR_MAX_WORKERS above 1 so broadcasts and forced closes cross workers.
SQR_WS_SHARED_BUS=memory
SQR_REDIS_WS_URL=
SQR_WS_MAX_CONNECTIONS=1000
SQR_WS_MAX_MESSAGE_BYTES=65536
SQR_MAX_WORKERS=1
SQR_PREALLOCATE_MB=0

IMPORT_BODY_LIMIT=50mb
IMPORT_INSERT_BATCH_SIZE=1000
IMPORT_MAX_ROW_BYTES=65536
COLLECTION_BODY_LIMIT=8mb
DEFAULT_BODY_LIMIT=2mb
HTTP_SLOW_REQUEST_MS=1500
ANALYTICS_TZ=Asia/Kuala_Lumpur
DEFAULT_SESSION_TIMEOUT_MINUTES=30
DEFAULT_WS_IDLE_MINUTES=3
DEFAULT_SEARCH_RESULT_LIMIT=200
DEFAULT_VIEWER_ROWS_PER_PAGE=100
MAINTENANCE_CACHE_TTL_MS=3000
RUNTIME_SETTINGS_CACHE_TTL_MS=3000
PG_POOL_WARN_COOLDOWN_MS=60000
BACKUP_OPERATION_TIMEOUT_MS=120000
IMPORT_ANALYSIS_TIMEOUT_MS=45000
COLLECTION_ROLLUP_LISTEN_RECONNECT_MS=5000

BACKUP_FEATURE_ENABLED=1
BACKUP_ENCRYPTION_KEY=ganti-dengan-kunci-enkripsi-backup-yang-kuat
BACKUP_ENCRYPTION_KEYS=
BACKUP_ENCRYPTION_KEY_ID=

LOCAL_SUPERUSER_CREDENTIALS_FILE_ENABLED=0

SEED_DEFAULT_USERS=0
SEED_SUPERUSER_USERNAME=
SEED_SUPERUSER_PASSWORD=
SEED_SUPERUSER_FULL_NAME=
SEED_ADMIN_USERNAME=
SEED_ADMIN_PASSWORD=
SEED_ADMIN_FULL_NAME=
SEED_USER_USERNAME=
SEED_USER_PASSWORD=
SEED_USER_FULL_NAME=
