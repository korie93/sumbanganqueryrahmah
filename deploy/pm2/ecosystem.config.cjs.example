module.exports = {
  apps: [
    {
      name: "sqr",
      cwd: "/absolute/path/to/sumbanganqueryrahmah",
      script: "dist-local/server/cluster-local.js",
      interpreter: "node",
      // Run `npm run build` before PM2 starts or restarts this process.
