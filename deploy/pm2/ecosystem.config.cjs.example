      env: {
        NODE_ENV: "production",
        // Nginx runs on this host, so keep the Node listener private.
        // Container deployments with a separate proxy may override this deliberately.
        HOST: "127.0.0.1",
        PORT: "5000",
        GRACEFUL_SHUTDOWN_TIMEOUT_MS: "10000",
      },
      // Medium-conservative baseline. See docs/DEPLOYMENT-SIZING-GUIDE.md
      // before changing memory limits or raising SQR_MAX_WORKERS above 1.
      max_memory_restart: "768M",
      node_args: "--max-old-space-size=600",
      min_uptime: "15s",
      max_restarts: 10,
      exp_backoff_restart_delay: 100,
      restart_delay: 5000,
      kill_timeout: 15000, // AUDIT-FIX [M14]: PM2 waits graceful shutdown timeout plus a 5s cleanup margin.
      listen_timeout: 5000,
      time: true,
    },
