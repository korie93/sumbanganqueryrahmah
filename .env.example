# Copy this file to `.env` locally and fill in real values.
# Never commit real secrets.

# Core app
NODE_ENV=development
PORT=5000
# Keep loopback for strict local development. Binding to 0.0.0.0 makes the
# runtime production-like and requires production hardening such as Redis-backed
# rate limiting/replay state.
HOST=127.0.0.1
DEBUG_LOGS=0
# Production-like runtime ignores debug/trace log levels and falls back to info.
# AI_DEBUG follows the same local-only policy.
AI_DEBUG=0
# Local-only operational diagnostics route gate. Production-like startup fails
# hard if this is enabled; keep it disabled on public hosts and use only for
# short-lived local/staging troubleshooting behind superuser auth.
OPERATIONS_DEBUG_ROUTES_ENABLED=0
LOG_LEVEL=info

# Session secret: must be generated per environment, kept private, and at least
# 32 bytes long. Non-test startup fails fast if this is shorter.
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
# Do not reuse this placeholder outside local examples.
SESSION_SECRET=GENERATE_ME_AT_LEAST_32_CHARS_DO_NOT_USE_IN_PRODUCTION
# Optional comma-separated previous session secrets accepted only for verification during a manual rotation window.
# Example: SESSION_SECRET_PREVIOUS=old-secret-1,old-secret-2
SESSION_SECRET_PREVIOUS=
# Dedicated HMAC key for tamper-evident security audit entries. If unset, the
# session secret is used as a compatibility fallback; production should set a
# separate value.
SQR_AUDIT_HMAC_KEY=GENERATE_ME_DISTINCT_AUDIT_HMAC_KEY_DO_NOT_REUSE_SESSION_SECRET
# Dedicated encryption key for stored 2FA secrets. Required before enabling 2FA.
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
# Store this separately from SESSION_SECRET so one secret leak does not compromise both controls.
TWO_FACTOR_ENCRYPTION_KEY=GENERATE_ME_DISTINCT_2FA_KEY_DO_NOT_REUSE_SESSION_SECRET
# Optional comma-separated previous 2FA encryption keys accepted only for decryption during a manual rotation window.
# Example: TWO_FACTOR_ENCRYPTION_KEY_PREVIOUS=old-2fa-key-1,old-2fa-key-2
TWO_FACTOR_ENCRYPTION_KEY_PREVIOUS=
# New 2FA enrollments use SHA256. Existing SHA1 enrollments remain verifiable because the algorithm is stored per payload.
# Roll back to SHA1 only if a planned authenticator compatibility issue affects new enrollments.
TWO_FACTOR_TOTP_ALGORITHM=SHA256
# Dedicated encryption key for collection PII shadow columns at rest.
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
# Keep this distinct from SESSION_SECRET, 2FA, and backup keys. New/updated collection rows will dual-write encrypted copies when configured.
COLLECTION_PII_ENCRYPTION_KEY=GENERATE_ME_COLLECTION_PII_KEY_DO_NOT_REUSE_SESSION_SECRET
# Optional comma-separated previous collection PII keys accepted only for decryption during a manual rotation window.
# Example: COLLECTION_PII_ENCRYPTION_KEY_PREVIOUS=old-collection-pii-key-1,old-collection-pii-key-2
COLLECTION_PII_ENCRYPTION_KEY_PREVIOUS=
# Optional staged retirement gate for live reads after plaintext rollout is complete for selected fields.
# Requires COLLECTION_PII_ENCRYPTION_KEY and should only be enabled after the relevant collection:pii-status checks are clean.
# Example staged sensitive retirement: COLLECTION_PII_RETIRED_FIELDS=icNumber,customerPhone,accountNumber
# Example full retirement: COLLECTION_PII_RETIRED_FIELDS=customerName,icNumber,customerPhone,accountNumber
COLLECTION_PII_RETIRED_FIELDS=

# Use an absolute app URL. Example: http://localhost:5000
PUBLIC_APP_URL=http://localhost:5000
# Comma-separated explicit absolute origins only. Do not include paths, query strings, hashes, or wildcard `*`.
CORS_ALLOWED_ORIGINS=http://localhost:5000,http://127.0.0.1:5000,http://localhost:5173,http://127.0.0.1:5173
# Optional explicit reverse proxies trusted to supply X-Forwarded-For for req.ip / rate limiting.
# Leave empty unless you are behind a known proxy such as Nginx, Caddy, Cloudflare Tunnel, or a load balancer.
# If X-Forwarded-For reaches the app while this is empty, startup will still
# work but runtime logs will warn that proxy-aware rate limiting may be ineffective.
# Runtime WebSocket origin checks will only honor X-Forwarded-Host / X-Forwarded-Proto when this list is set.
# Example: TRUSTED_PROXIES=loopback,10.0.0.0/8
TRUSTED_PROXIES=
# In production behind Nginx/TLS, keep auto or set true. Never force false on
# public HTTPS deployments; runtime will fail-safe to secure cookies on
# production-like hosts.
AUTH_COOKIE_SECURE=auto
# Use strict by default because the current auth flow is same-site and does not
# depend on cross-site redirects or third-party OAuth callbacks.
SESSION_COOKIE_SAMESITE=strict
# Helmet owns the Strict-Transport-Security header. For production preload,
# first confirm every production subdomain is HTTPS-only, includeSubDomains is
# acceptable for the full domain tree, then set max-age to at least 31536000,
# set HSTS_PRELOAD_ENABLED=1, deploy, and submit to https://hstspreload.org.
HSTS_MAX_AGE_SECONDS=31536000
HSTS_PRELOAD_ENABLED=0

# PostgreSQL
# Optional single PostgreSQL URL. If set, it must include host, user, database,
# and, on production-like hosts, an embedded password because the PostgreSQL
# pool uses DATABASE_URL as the complete connection string. Do not rely on
# PG_PASSWORD to patch a passwordless DATABASE_URL.
# Current runtime assumes a single primary PostgreSQL connection. Dedicated
# read-replica / reporting connection env vars are not part of the supported
# config surface yet.
# Example: DATABASE_URL=postgres://postgres:strong-password@localhost:5432/sqr_db
DATABASE_URL=
# TLS is enforced automatically on production-like hosts. Keep this disabled
# only for local PostgreSQL instances that do not terminate SSL/TLS. If your
# managed database uses a private/self-signed CA, set DATABASE_SSL_CA_FILE to
# its PEM root certificate instead of disabling verification.
DATABASE_SSL=0
DATABASE_SSL_CA=
DATABASE_SSL_CA_FILE=
PG_HOST=127.0.0.1
PG_PORT=5432
PG_USER=postgres
# Database password: use a strong password from your deployment secret manager
# or process manager environment file with restricted permissions. Avoid
# exporting or pasting PG_PASSWORD inline in shell commands because it can be
# captured by shell history, process listings, CI logs, or terminal scrollback.
# Generate example: node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
PG_PASSWORD=GENERATE_ME_DB_PASSWORD_DO_NOT_USE_IN_PRODUCTION
PG_DATABASE=sqr_db
# Runtime default is at least 10. Keep 5 only on very small local/dev boxes; production
# deployments should start at 10-20 after checking PostgreSQL max_connections headroom.
PG_MAX_CONNECTIONS=10
PG_IDLE_TIMEOUT_MS=30000
PG_CONNECTION_TIMEOUT_MS=5000
# Aborts runaway SQL statements at the PostgreSQL layer. Keep this below
# HTTP_REQUEST_TIMEOUT_MS; increase deliberately if backup/report queries need
# a longer production window and monitor slow-query logs.
PG_STATEMENT_TIMEOUT_MS=30000
PG_SEARCH_PATH=public
# Leave empty to use runtime bootstrap in local development and migration-first
# startup on production-like hosts. Set runtime only for legacy recovery.
# In production, run npm run db:migrate before pm2 restart.
SQR_DB_BOOTSTRAP_MODE=
# Emergency-only escape hatch. Production-like hosts reject runtime bootstrap
# unless this is set to 1 for a deliberate legacy recovery window, then removed.
SQR_ALLOW_RUNTIME_DB_BOOTSTRAP_IN_PRODUCTION=0

# Collection nickname temporary password (auto-generated in dev if empty)
COLLECTION_NICKNAME_TEMP_PASSWORD=

# Receipt security / quarantine
COLLECTION_RECEIPT_QUARANTINE_ENABLED=1
COLLECTION_RECEIPT_QUARANTINE_DIR=var/collection-receipt-quarantine
COLLECTION_RECEIPT_EXTERNAL_SCAN_ENABLED=1
# Preferred ClamAV daemon command for production uploads. For local machines
# without ClamAV installed, set COLLECTION_RECEIPT_EXTERNAL_SCAN_ENABLED=0 only
# while developing upload UI flows. Production should fail closed on scan errors.
# Startup resolves this command to a real executable and only accepts ClamAV
# scanners from approved scanner directories such as /usr/bin, /usr/local/bin,
# /opt/clamav/bin, or /opt/scanner/bin. Test Node shims are blocked in production.
COLLECTION_RECEIPT_EXTERNAL_SCAN_COMMAND=clamdscan
COLLECTION_RECEIPT_EXTERNAL_SCAN_ARGS_JSON='["--fdpass","--no-summary","--infected","{file}"]'
# Fallback non-daemon command:
# COLLECTION_RECEIPT_EXTERNAL_SCAN_COMMAND=clamscan
# COLLECTION_RECEIPT_EXTERNAL_SCAN_ARGS_JSON='["--no-summary","--infected","{file}"]'
COLLECTION_RECEIPT_EXTERNAL_SCAN_TIMEOUT_MS=60000
COLLECTION_RECEIPT_EXTERNAL_SCAN_FAIL_CLOSED=1
COLLECTION_RECEIPT_EXTERNAL_SCAN_CLEAN_EXIT_CODES=0
COLLECTION_RECEIPT_EXTERNAL_SCAN_REJECT_EXIT_CODES=1

# Mail / activation / password reset
# Leave all SMTP_* values empty if email delivery is disabled.
# Set real SMTP credentials only in private environment files or secret stores. Never commit them.
MAIL_FROM=
SMTP_SERVICE=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURE=false
SMTP_REQUIRE_TLS=false
MAIL_DEV_OUTBOX_ENABLED=0
MAIL_DEV_OUTBOX_DIR=var/dev-mail-outbox
MAIL_DEV_OUTBOX_MAX_FILES=100

# AI / Ollama
# Required when AI chat or semantic embedding features are enabled. If you do
# not run Ollama, leave these values at safe defaults and expect AI requests to
# fail closed or use the app's non-AI fallbacks instead.
# Embedding-backed search also requires PostgreSQL pgvector support. Ensure the
# database can run:
#   CREATE EXTENSION IF NOT EXISTS vector;
# The reviewed migrations attempt this automatically, but managed PostgreSQL
# hosts may require the extension package to be enabled separately first.
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_CHAT_MODEL=llama3:8b
OLLAMA_EMBED_MODEL=nomic-embed-text
# Raise only after measuring your Ollama host latency; lower values fail faster
# and let the app fall back instead of keeping requests open.
OLLAMA_TIMEOUT_MS=10000
DEFAULT_AI_TIMEOUT_MS=10000
AI_PRECOMPUTE_ON_START=0
AI_GATE_GLOBAL_LIMIT=4
AI_GATE_SUPERUSER_LIMIT=1
AI_GATE_ADMIN_LIMIT=1
AI_GATE_USER_LIMIT=2
AI_GATE_QUEUE_LIMIT=20
AI_GATE_QUEUE_WAIT_MS=12000
AI_LATENCY_DECAY_HALF_LIFE_MS=30000
AI_LATENCY_STALE_AFTER_MS=20000

# Search / runtime tuning
SQR_LOW_MEMORY_MODE=1
# Tune with observed search hit-rate and memory headroom. Keep low for small VPS
# deployments; larger values retain more cached search results in-process.
# Production recommendation: 200-500 once memory headroom is verified.
SQR_MAX_SEARCH_CACHE_ENTRIES=60
SQR_MAX_AI_LAST_PERSON_ENTRIES=40
SQR_AI_LAST_PERSON_TTL_MS=1800000
# When SQR_MAX_WORKERS=1, the server starts in single-process mode to avoid an unnecessary cluster master.
# SQR_MAX_WORKERS > 1 requires SQR_RATE_LIMIT_STORE=redis and SQR_REDIS_RATE_LIMIT_URL.
# Memory rate limiting is process-local and startup will fail for multi-worker mode without Redis.
# Production-like hosts must use Redis even with one worker so fixed-window counters,
# adaptive runtime protection buckets, 2FA replay protection, and JWT logout revocation
# checks are shared and fail closed if the configured store becomes unavailable.
# WebSocket runtime events still need SQR_WS_SHARED_BUS=redis before multi-worker production deployments.
SQR_RATE_LIMIT_STORE=memory
SQR_REDIS_RATE_LIMIT_URL=
# Per-authenticated-user adaptive limits. Values are per minute; runtime
# converts them to the 10s adaptive window and still applies the IP bucket too.
SQR_RATE_LIMIT_USER_READS_PER_MINUTE=500
SQR_RATE_LIMIT_USER_WRITES_PER_MINUTE=100
SQR_RATE_LIMIT_USER_UPLOADS_PER_MINUTE=10
# Active only when a Redis-backed runtime store or WebSocket bus is configured.
# The runtime health monitor pings each unique Redis endpoint and repeats
# warnings while Redis remains unavailable.
SQR_REDIS_HEALTH_CHECK_INTERVAL_MS=60000
# Optional WebSocket Redis pub/sub fan-out for settings broadcasts and
# cross-worker activity close propagation. If SQR_REDIS_WS_URL is empty, the
# rate-limit Redis URL is reused when SQR_WS_SHARED_BUS=redis.
SQR_WS_SHARED_BUS=memory
SQR_REDIS_WS_URL=
# Server-wide WebSocket cap, including authenticated clients and in-flight handshakes.
SQR_WS_MAX_CONNECTIONS=1000
# Maximum inbound WebSocket message payload accepted by the runtime. Normal SQR
# clients should not need inbound WS payloads larger than this 64KB cap.
SQR_WS_MAX_MESSAGE_BYTES=65536
# Set SQR_INITIAL_WORKERS to control how many workers boot immediately. It cannot exceed SQR_MAX_WORKERS.
# Set SQR_FORCE_CLUSTER=1 only if you explicitly need cluster IPC behavior while keeping one worker.
SQR_MAX_WORKERS=1
SQR_INITIAL_WORKERS=1
SQR_FORCE_CLUSTER=0
SQR_PREALLOCATE_MB=0

# Request limits / analytics
# 96mb is the current upper bound for legacy JSON/import payloads. Keep Nginx
# client_max_body_size slightly higher, prefer multipart/chunked import flows
# for large files, and lower this value in small-memory deployments after
# validating expected import sizes in staging.
IMPORT_BODY_LIMIT=96mb
# Caps the total staged multipart import bytes a single authenticated user can
# upload at one time. Keep this at or above IMPORT_BODY_LIMIT so one normal
# upload can still complete, and raise it only if you intentionally allow
# multiple concurrent imports per user.
IMPORT_PER_USER_ACTIVE_UPLOAD_BYTES=100663296
# Backward-compatible row cap used for CSV uploads and as a server-side safety
# guard for spreadsheet imports before rows are materialized into import records.
IMPORT_CSV_MAX_ROWS=100000
# CSV multipart imports are streamed row-by-row and flushed to the database in
# bounded chunks. Keep this high enough for throughput but low enough to avoid
# a burst of concurrent row writes on small PostgreSQL plans.
IMPORT_INSERT_BATCH_SIZE=1000
# Reject individual import rows above this serialized byte budget.
IMPORT_MAX_ROW_BYTES=65536
COLLECTION_BODY_LIMIT=8mb
DEFAULT_BODY_LIMIT=2mb
HTTP_SLOW_REQUEST_MS=1500
ANALYTICS_TZ=Asia/Kuala_Lumpur
# Session idle timeout tuning is bounded at startup: 1..1440 minutes.
# Keep production values short enough for account-risk tolerance; raise only
# when paired with explicit session revocation and monitoring.
DEFAULT_SESSION_TIMEOUT_MINUTES=30
DEFAULT_WS_IDLE_MINUTES=3
DEFAULT_SEARCH_RESULT_LIMIT=200
DEFAULT_VIEWER_ROWS_PER_PAGE=100
MAINTENANCE_CACHE_TTL_MS=3000
RUNTIME_SETTINGS_CACHE_TTL_MS=3000
PG_POOL_WARN_COOLDOWN_MS=60000
GRACEFUL_SHUTDOWN_TIMEOUT_MS=25000
BACKUP_OPERATION_TIMEOUT_MS=120000
IMPORT_ANALYSIS_TIMEOUT_MS=45000
COLLECTION_ROLLUP_LISTEN_RECONNECT_MS=5000

# Backup safety
BACKUP_FEATURE_ENABLED=1
# Required outside strict local development when backups are enabled.
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
# Store outside the backup destination. Losing this key means encrypted backups cannot be restored.
# Placeholder values are rejected on production-like startup and must never be deployed.
BACKUP_ENCRYPTION_KEY=GENERATE_ME_BACKUP_KEY_AND_STORE_OFFLINE
BACKUP_ENCRYPTION_KEYS=
BACKUP_ENCRYPTION_KEY_ID=
# Refuse backup create/export payloads that exceed this byte limit to avoid runaway memory pressure.
# Increase only after verifying production memory headroom and backup export timings.
BACKUP_MAX_PAYLOAD_BYTES=33554432

# Local-only helpers
# DANGER: local troubleshooting only. Never enable this on public, staging, or
# production hosts. When enabled, local superuser credentials may be read from
# or written to a filesystem helper file, so leaked server files could expose
# emergency credentials.
LOCAL_SUPERUSER_CREDENTIALS_FILE_ENABLED=0

# Optional seed data for local development only
SEED_DEFAULT_USERS=0
SEED_SUPERUSER_USERNAME=
SEED_SUPERUSER_PASSWORD=
SEED_SUPERUSER_FULL_NAME=
SEED_ADMIN_USERNAME=
SEED_ADMIN_PASSWORD=
SEED_ADMIN_FULL_NAME=
SEED_USER_USERNAME=
SEED_USER_PASSWORD=
SEED_USER_FULL_NAME=
